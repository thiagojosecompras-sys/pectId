
{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Informações básicas e estado clínico do paciente",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "age": { "type": "number" },
        "clinicalId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "discharged", "critical"] },
        "type": { "type": "string", "enum": ["Motor", "Cognitivo", "ADL", "Multimodal"] },
        "lastVisit": { "type": "string", "format": "date" }
      },
      "required": ["name", "clinicalId", "status"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Atividade de reabilitação vinculada a um paciente",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "difficultyType": { "type": "string", "enum": ["motor", "cognitive", "dailyActivity"] },
        "status": { "type": "string", "enum": ["pending", "completed", "skipped"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Evolution": {
      "title": "Evolution",
      "description": "Registro de evolução clínica vinculado a um paciente",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "note": { "type": "string" },
        "professional": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": "#/backend/entities/Patient",
      "description": "Documento principal do paciente"
    },
    "/activities/{activityId}": {
      "schema": "#/backend/entities/Activity",
      "description": "Coleção global de atividades vinculadas por patientId"
    },
    "/evolutions/{evolutionId}": {
      "schema": "#/backend/entities/Evolution",
      "description": "Coleção global de evoluções vinculadas por patientId"
    }
  }
}
